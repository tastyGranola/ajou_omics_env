{
  "name": "ajou-omics-scrnaseq",
  "image": "mcr.microsoft.com/devcontainers/python:3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    }
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },
  "secrets": {
    "CLAUDE_CODE_OAUTH_TOKEN": {
      "description": "Claude Code 인증 토큰. 설정해 두면 Codespace 안에서 별도 로그인 없이 claude 가 바로 인증됩니다. 로컬에서 `claude setup-token` 으로 발급받아 등록하세요.",
      "documentationUrl": "https://docs.claude.com/en/docs/claude-code/setup"
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-renderers"
      ],
      "settings": {
        "workbench.colorTheme": "Default Dark Modern",
        "workbench.preferredDarkColorTheme": "Default Dark Modern",
        "window.autoDetectColorScheme": false,
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.terminal.activateEnvInCurrentTerminal": true,
        "jupyter.askForKernelRestart": false,
        "notebook.output.textLineLimit": 60,
        "files.autoSave": "afterDelay",
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "remoteUser": "vscode"
}
